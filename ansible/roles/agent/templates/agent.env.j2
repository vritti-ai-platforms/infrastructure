# Managed by Ansible (roles/agent). The enroll token is consumed on first enrollment only;
# afterwards the agent authenticates with its cached credential + local keys.
VRITTI_CLOUD_API_URL={{ cloud_url }}
VRITTI_DEPLOYMENT_ID={{ deployment_id }}
VRITTI_ENROLL_TOKEN={{ enroll_token }}
VRITTI_DATA_DIR={{ agent_data_dir }}
VRITTI_STACK_ROOT={{ agent_stack_root }}
# Nothing else. The agent is generic: it enrolls with cloud and receives its secret-store config
# (Infisical connection + auth) in the signed desired-state — nothing store-specific lives here.
