# Managed by Ansible (roles/agent).
[Unit]
Description=Vritti Application Agent
After=docker.service
Requires=docker.service

[Service]
# Clean any prior container, then run the agent with access to the Docker socket, its state
# dir, the core stack root (bind-mount source the agent renders containers against), and the
# host Docker config (read-only) so the agent can pull PRIVATE images with the credentials
# `docker login` (roles/docker) already wrote — no registry auth baked into the agent.
ExecStartPre=-/usr/bin/docker rm -f vritti-agent
ExecStart=/usr/bin/docker run --rm --name vritti-agent \
  --env-file {{ agent_config_dir }}/agent.env \
  -e DOCKER_CONFIG=/root/.docker \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -v /root/.docker:/root/.docker:ro \
  -v {{ agent_data_dir }}:{{ agent_data_dir }} \
  -v {{ agent_stack_root }}:{{ agent_stack_root }} \
  {{ agent_image }}:{{ agent_image_tag }}
ExecStop=/usr/bin/docker stop vritti-agent
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
