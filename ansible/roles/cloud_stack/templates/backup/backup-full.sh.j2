#!/usr/bin/env bash
# Managed by Ansible (roles/cloud_stack). Cloud DB FULL pgBackRest backup -> repo1 (local) then
# repo2 (Cloudflare R2). Stanza: {{ cloud_backrest_stanza }}. Runs via `docker exec` into postgres.
set -euo pipefail
export PATH=/usr/local/bin:/usr/bin:/bin

CONTAINER="postgres"
STANZA="{{ cloud_backrest_stanza }}"
log() { echo "[cloud-backup-full] $(date -u +%FT%TZ) $*"; }

log "REPO1 (local) full backup..."
docker exec -u postgres "$CONTAINER" pgbackrest --stanza="$STANZA" --repo=1 --type=full backup
log "REPO2 (R2) full backup..."
docker exec -u postgres "$CONTAINER" pgbackrest --stanza="$STANZA" --repo=2 --type=full backup
log "info:"
docker exec -u postgres "$CONTAINER" pgbackrest --stanza="$STANZA" info
log "done"
