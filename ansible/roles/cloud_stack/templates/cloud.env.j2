# Managed by Ansible (roles/cloud_stack) — cloud-server environment (/opt/vritti/cloud/.env)
NODE_ENV=production
PORT=3000

# Control-plane database (cloud stays env-schema based).
PRIMARY_DB_HOST=postgres
PRIMARY_DB_PORT=5432
PRIMARY_DB_DATABASE={{ cloud_db_name }}
PRIMARY_DB_USERNAME={{ cloud_db_app }}
PRIMARY_DB_PASSWORD={{ cloud_db_password }}
PRIMARY_DB_SSL_MODE=disable
PRIMARY_DB_SCHEMA={{ cloud_db_schema }}
PRIMARY_DB_MIGRATION_SCHEMA={{ cloud_db_migration_schema }}
DATABASE_DIRECT_URL=postgresql://{{ cloud_db_owner }}:{{ cloud_db_password }}@postgres:5432/{{ cloud_db_name }}?sslmode=disable

# Infra.
REDIS_URL=redis://:{{ cloud_redis_password }}@redis:6379
NATS_URL=nats://nats:4222

# App crypto.
JWT_SECRET={{ cloud_jwt_secret }}
HMAC_KEY={{ cloud_hmac_key }}
COOKIE_SECRET={{ cloud_cookie_secret }}

BASE_DOMAIN={{ cloud_domain }}
