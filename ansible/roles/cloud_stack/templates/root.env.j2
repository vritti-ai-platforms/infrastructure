# Managed by Ansible (roles/cloud_stack) — compose interpolation for /opt/vritti/docker-compose.yml.
# Redis password parsed from production's REDIS_URL so the container's requirepass matches.
REDIS_PASSWORD={{ _redis_pass }}
{% if cloud_backrest_enabled | bool %}
# Cloud DB pgBackRest -> R2 (stanza `{{ cloud_backrest_stanza }}`). Injected into the postgres +
# cloud-pgbackrest containers as PGBACKREST_* env. CLOUD_DB_PASSWORD = production's owner role.
CLOUD_DB_PASSWORD={{ _db_pass }}
CLOUD_BACKREST_R2_ENDPOINT={{ cloud_backrest_r2_endpoint }}
CLOUD_BACKREST_R2_BUCKET={{ cloud_backrest_r2_bucket }}
CLOUD_BACKREST_R2_ACCESS_KEY={{ cloud_backrest_r2_access_key }}
CLOUD_BACKREST_R2_SECRET_KEY={{ cloud_backrest_r2_secret_key }}
CLOUD_BACKREST_REPO1_CIPHER_PASS={{ cloud_backrest_repo1_cipher_pass }}
CLOUD_BACKREST_REPO2_CIPHER_PASS={{ cloud_backrest_repo2_cipher_pass }}
{% endif %}
