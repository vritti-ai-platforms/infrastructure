# Managed by Ansible (roles/cloud_stack). The CLOUD control-plane stack on vm1.
# The dev vritti-core stack on this same host is NOT here — the agent owns that.
name: vritti-cloud

x-logging: &logging
  driver: json-file
  options: { max-size: "10m", max-file: "3" }

services:
  nginx:
    image: {{ cloud_nginx_image }}
    container_name: nginx
    restart: unless-stopped
    ports: ["80:80", "443:443"]
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./nginx/conf.d:/etc/nginx/conf.d:ro
      - ./ssl:/etc/nginx/ssl:ro
      - ./www:/usr/share/nginx/html:ro
      - ./logs/nginx:/var/log/nginx
    networks: [cloud, core]        # attaches to the agent's core net to route *.dev
    mem_limit: 96m
    logging: *logging

  cloud-server:
    image: {{ cloud_server_image }}:{{ cloud_server_tag }}
    container_name: cloud-server
    restart: unless-stopped
    env_file: [./cloud/.env]
    environment: [NODE_ENV=production, PORT=3000]
    expose: ["3000"]
    volumes:
      - ./logs/cloud:/app/logs
      # GeoLite2 DB — populated + kept fresh by the geoip role (geoipupdate), which runs first.
      - ./geoip/GeoLite2-City.mmdb:/app/data/GeoLite2-City.mmdb:ro
    depends_on:
      postgres: { condition: service_healthy }
      redis: { condition: service_started }
      nats: { condition: service_started }
    networks: [cloud]
    mem_limit: 384m
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:3000/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    logging: *logging

  cloud-migrate:
    image: {{ cloud_server_image }}:{{ cloud_server_tag }}
    container_name: cloud-migrate
    env_file: [./cloud/.env]
    environment: [NODE_ENV=production]
    command: ["node", "dist/db/migrate.js"]
    restart: "no"
    profiles: ["migrate"]
    depends_on:
      postgres: { condition: service_healthy }
    networks: [cloud]
    logging: *logging

  postgres:
    image: {{ cloud_postgres_image }}
    container_name: postgres
    restart: unless-stopped
    # DB creds come from production (single role = owner = app); see cloud-db.env.
    env_file: [./cloud-db.env]
{% if cloud_backrest_enabled | bool %}
    # WAL archiving -> pgBackRest (repo1 local + repo2 R2, stanza `{{ cloud_backrest_stanza }}`).
    command:
      - postgres
      - -c
      - wal_level=replica
      - -c
      - archive_mode=on
      - -c
      - "archive_command=pgbackrest --stanza={{ cloud_backrest_stanza }} archive-push %p"
      - -c
      - archive_timeout=60
    environment:
      - PGBACKREST_REPO1_CIPHER_TYPE=aes-256-cbc
      - PGBACKREST_REPO1_CIPHER_PASS=${CLOUD_BACKREST_REPO1_CIPHER_PASS}
      - PGBACKREST_REPO2_CIPHER_TYPE=aes-256-cbc
      - PGBACKREST_REPO2_CIPHER_PASS=${CLOUD_BACKREST_REPO2_CIPHER_PASS}
      - PGBACKREST_REPO2_S3_BUCKET=${CLOUD_BACKREST_R2_BUCKET}
      - PGBACKREST_REPO2_S3_ENDPOINT=${CLOUD_BACKREST_R2_ENDPOINT}
      - PGBACKREST_REPO2_S3_KEY=${CLOUD_BACKREST_R2_ACCESS_KEY}
      - PGBACKREST_REPO2_S3_KEY_SECRET=${CLOUD_BACKREST_R2_SECRET_KEY}
      - PGBACKREST_PG1_PASSWORD=${CLOUD_DB_PASSWORD}
{% endif %}
    volumes:
      - ./pgdata:/var/lib/postgresql/data
{% if cloud_backrest_enabled | bool %}
      - ./pgbackrest.conf:/etc/pgbackrest/pgbackrest.conf:ro
      - pgbackrest_local:/var/lib/pgbackrest
      - pgbackrest_log:/var/log/pgbackrest
{% endif %}
    expose: ["5432"]
    networks: [cloud]
    mem_limit: 512m
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \"$$POSTGRES_USER\" -d \"$$POSTGRES_DB\""]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s
    logging: *logging

{% if cloud_backrest_enabled | bool %}
  # Idle sidecar for RESTORE (RW access to ./pgdata). Scheduled backups run via `docker exec` into
  # the postgres container on the host cron (see roles/cloud_stack backup scripts + cron install).
  cloud-pgbackrest:
    image: {{ cloud_postgres_image }}
    container_name: cloud-pgbackrest
    restart: unless-stopped
    depends_on:
      postgres: { condition: service_healthy }
    command: ["sleep", "infinity"]
    environment:
      - PGBACKREST_REPO1_CIPHER_TYPE=aes-256-cbc
      - PGBACKREST_REPO1_CIPHER_PASS=${CLOUD_BACKREST_REPO1_CIPHER_PASS}
      - PGBACKREST_REPO2_CIPHER_TYPE=aes-256-cbc
      - PGBACKREST_REPO2_CIPHER_PASS=${CLOUD_BACKREST_REPO2_CIPHER_PASS}
      - PGBACKREST_REPO2_S3_BUCKET=${CLOUD_BACKREST_R2_BUCKET}
      - PGBACKREST_REPO2_S3_ENDPOINT=${CLOUD_BACKREST_R2_ENDPOINT}
      - PGBACKREST_REPO2_S3_KEY=${CLOUD_BACKREST_R2_ACCESS_KEY}
      - PGBACKREST_REPO2_S3_KEY_SECRET=${CLOUD_BACKREST_R2_SECRET_KEY}
      - PGBACKREST_PG1_PASSWORD=${CLOUD_DB_PASSWORD}
    volumes:
      - ./pgdata:/var/lib/postgresql/data
      - ./pgbackrest.conf:/etc/pgbackrest/pgbackrest.conf:ro
      - pgbackrest_local:/var/lib/pgbackrest
      - pgbackrest_log:/var/log/pgbackrest
    networks: [cloud]
    mem_limit: 256m
    logging: *logging
{% endif %}

  redis:
    image: {{ cloud_redis_image }}
    container_name: redis
    restart: unless-stopped
    command:
      - redis-server
      - --maxmemory
      - 128mb
      - --maxmemory-policy
      - allkeys-lru
      - --save
      - ""
      - --requirepass
      - ${REDIS_PASSWORD:?set in .env}
    expose: ["6379"]
    networks: [cloud]
    mem_limit: 160m
    logging: *logging

  nats:
    image: {{ cloud_nats_image }}
    container_name: nats
    restart: unless-stopped
    expose: ["4222"]
    networks: [cloud]
    mem_limit: 96m
    logging: *logging

  # DbLab (thin clones) — dev-only, behind dblab. + Zero-Trust. Uses ZFS (file-vdev pool) + the
  # docker socket to spin per-clone Postgres containers. Config in dblab/server.yml.
  dblab:
    image: {{ cloud_dblab_image }}
    container_name: dblab
    restart: unless-stopped
    privileged: true
    environment: [DLE_COMPUTE_ENV=docker]
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ dblab_mount_dir }}:{{ dblab_mount_dir }}:rshared
      - ./dblab:/home/dblab/configs
    expose: ["2345"]
    networks: [cloud]
    mem_limit: 512m
    logging: *logging

{% if cloud_backrest_enabled | bool %}
volumes:
  pgbackrest_local:
    driver: local
  pgbackrest_log:
    driver: local
{% endif %}

networks:
  cloud:
    name: vritti-network
    driver: bridge
  core:
    name: {{ core_network_name }}
    external: true
