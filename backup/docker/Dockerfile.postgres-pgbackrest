# Custom PostgreSQL 16 image with pgBackRest installed
# Used for both the infisical-postgres container (WAL archiving via archive_command)
# and the infisical-pgbackrest sidecar container (backup/restore operations)
#
# Uses postgres:16-bookworm (Debian) instead of 16-alpine because
# pgBackRest is available via the official PGDG apt repository on Debian.

FROM postgres:16-bookworm

# Install pgBackRest from the PostgreSQL Global Development Group apt repo
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        gnupg \
        lsb-release \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSo /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
        https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] \
        https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends pgbackrest \
    && rm -rf /var/lib/apt/lists/*

# Create pgBackRest directories owned by the postgres user (UID 999).
# When Docker mounts a new named volume at /var/lib/pgbackrest, it copies
# this directory structure (with ownership) into the volume on first use.
# This ensures archive_command (running as the postgres OS user) can write WAL.
RUN mkdir -p /var/lib/pgbackrest /var/log/pgbackrest /etc/pgbackrest /tmp/pgbackrest \
    && chown -R postgres:postgres /var/lib/pgbackrest /var/log/pgbackrest /etc/pgbackrest /tmp/pgbackrest
