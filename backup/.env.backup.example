# Infisical Backup Environment Variables
# =========================================
# Copy this file to /opt/infisical/backup/.env.backup on the server
# and fill in the actual values.
#
# This file is loaded by backup-redis.sh and verify-backup.sh.
# pgBackRest credentials are injected via docker-compose.override.yml
# using variables from the main /opt/infisical/.env file.
#
# DO NOT commit the actual .env.backup file to git (it is in .gitignore).
# Store the values in GitHub Secrets (see infisical-deploy.yml).

# ----------------------------------------------------------------
# Cloudflare R2 Configuration
# ----------------------------------------------------------------
# Your Cloudflare account R2 endpoint.
# Format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
BACKREST_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# R2 bucket name (create this in Cloudflare Dashboard → R2 → Create bucket)
BACKREST_R2_BUCKET=infisical-backups

# R2 API Token credentials
# Create at: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Permissions needed: Object Read & Write on the infisical-backups bucket
BACKREST_R2_ACCESS_KEY=your_r2_access_key_id_here
BACKREST_R2_SECRET_KEY=your_r2_secret_access_key_here

# ----------------------------------------------------------------
# pgBackRest Repository Encryption
# ----------------------------------------------------------------
# Each repo uses a different passphrase (compromise of one does not affect the other).
# Generate strong passphrases with:
#   openssl rand -base64 48
#
# CRITICAL: Store these passphrases securely (password manager, secrets vault).
# If you lose the passphrase, the backup is unrecoverable.
BACKREST_REPO1_CIPHER_PASS=generate_a_strong_passphrase_for_local_repo

BACKREST_REPO2_CIPHER_PASS=generate_a_different_strong_passphrase_for_r2_repo

# ----------------------------------------------------------------
# Redis Backup Settings
# ----------------------------------------------------------------
# Local directory for Redis RDB backups (follows /opt/vritti/ pattern)
REDIS_BACKUP_LOCAL_DIR=/opt/vritti/backups/infisical/redis

# Redis container name (matches docker-compose container_name)
REDIS_CONTAINER=infisical-redis

# ----------------------------------------------------------------
# Verification Settings
# ----------------------------------------------------------------
# Alert if newest backup is older than this many hours (default: 26h)
# Set to 26h to catch cases where the 02:00 UTC job failed.
BACKUP_MAX_AGE_HOURS=26
