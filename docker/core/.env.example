# =============================================================================
# core stack runtime env  ->  copy to /opt/vritti/core/.env  (chmod 600)
# Shared by core-server AND commerce-service (commerce overrides APP_NAME, and
# PRIMARY_DB_SCHEMA if it uses its own schema — see docker-compose.yml).
# Every var is validated at boot. Secrets marked CHANGE_ME.
# =============================================================================

# ---- Application ----
NODE_ENV=production
PORT=3002
USE_HTTPS=false
APP_NAME=core-server
APP_HOST=dev.vrittiai.com
# Same-origin in prod, so CORS is rarely triggered; set exact origins if you need cross-origin XHR.
CORS_ORIGINS=https://dev.vrittiai.com

# ---- Multi-tenant domain (wildcard tenants live under this) ----
BASE_DOMAIN=dev.vrittiai.com
ALLOW_RAW_IP_HOST_ROUTING=false

# ---- Logging ----
LOG_PROVIDER=winston
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_FILE_PATH=/app/logs
LOG_MAX_FILES=14d
MASK_PII=true

# ---- Security ----
COOKIE_SECRET=CHANGE_ME_distinct_random_min_32_chars
HMAC_KEY=CHANGE_ME_distinct_random_min_32_chars
BCRYPT_SALT_ROUNDS=12

# ---- JWT ----
JWT_SECRET=CHANGE_ME_64_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# ---- Cookie / session (scoped to the dev tenant domain) ----
REFRESH_COOKIE_NAME=vritti_core_refresh
REFRESH_COOKIE_DOMAIN=.dev.vrittiai.com

# ---- Primary database (NATIVE Postgres on the VM host) ----
PRIMARY_DB_HOST=host.docker.internal
PRIMARY_DB_PORT=5432
PRIMARY_DB_USERNAME=core_user
PRIMARY_DB_PASSWORD=CHANGE_ME
PRIMARY_DB_DATABASE=vritti_db
PRIMARY_DB_SCHEMA=vritti_core
PRIMARY_DB_SSL_MODE=disable
# Full URL for drizzle migrations (same DB, direct connection)
PRIMARY_DB_DATABASE_DIRECT_URL=postgres://core_user:CHANGE_ME@host.docker.internal:5432/vritti_db?sslmode=disable

# ---- NATS (core-server publishes; commerce-service consumes) ----
NATS_URL=nats://nats:4222

# ---- Redis (shared container; password must match /opt/vritti/.env) ----
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1

# ---- Cross-service ----
CLOUD_API_URL=https://cloud.vrittiai.com
NEXUS_WEBHOOK_SECRET=CHANGE_ME

# ---- OTP ----
OTP_EXPIRY=10m
OTP_MAX_ATTEMPTS=5

# ---- Cloudflare R2 (media storage) ----
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=vritti-core-media
R2_PUBLIC_BUCKET=vritti-core-public
R2_PUBLIC_URL=https://media.vrittiai.com
MEDIA_MAX_FILE_SIZE_MB=10
MEDIA_STORAGE_PROVIDER=r2
MEDIA_SIGNED_URL_EXPIRY=3600

# ---- Email (Brevo — optional for core) ----
BREVO_API_KEY=
SENDER_EMAIL=noreply@vrittiai.com
SENDER_NAME=Vritti
