# =============================================================================
# Microservice runtime env  (template — modeled on commerce-service, a NATS worker)
#
# A NATS microservice has NO HTTP server: no PORT, JWT, cookies, CORS, CSRF, R2,
# or email. It needs only a DB connection + the NATS bus. Every var is validated
# at boot (class-validator) — the process exits if one is missing.
#
# ⚠️ commerce-service has no separate deploy file: docker-compose.yml gives it
#    `env_file: ./core/.env` and overrides APP_NAME, so its values already live
#    in core/.env. A NEW microservice needing its own creds would get its own
#    /opt/vritti/<name>/.env (this template) + an env_file entry in compose.
# =============================================================================

# ---- Application ----
NODE_ENV=production
APP_NAME=commerce-service

# ---- NATS message bus (optional — omit to use the in-cluster default) ----
NATS_URL=nats://nats:4222

# ---- Primary database (a microservice shares its sibling server's Postgres + schema) ----
PRIMARY_DB_HOST=host.docker.internal      # native Postgres on the VM host
PRIMARY_DB_PORT=5432
PRIMARY_DB_USERNAME=core_user
PRIMARY_DB_PASSWORD=CHANGE_ME             # must match core/.env
PRIMARY_DB_DATABASE=vritti_db
PRIMARY_DB_SCHEMA=vritti_core             # commerce-service shares core's schema
PRIMARY_DB_MIGRATION_SCHEMA=core_drizzle  # shares core's migration bookkeeping schema (own table)
PRIMARY_DB_SSL_MODE=disable               # disable for host PG; require for managed PG
# Direct (non-pooled) URL — used only by `drizzle-kit migrate`
PRIMARY_DB_DATABASE_DIRECT_URL=postgres://core_user:CHANGE_ME@host.docker.internal:5432/vritti_db?sslmode=disable
