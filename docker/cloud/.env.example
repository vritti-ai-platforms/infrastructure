# =============================================================================
# cloud-server runtime env  ->  copy to /opt/vritti/cloud/.env  (chmod 600)
# Every var below is validated at boot (class-validator). Missing/!valid = crash.
# Secrets marked CHANGE_ME. Non-secret defaults are production-sane.
# =============================================================================

# ---- Application ----
NODE_ENV=production
PORT=3000
USE_HTTPS=false                       # nginx terminates TLS; app speaks HTTP internally
APP_NAME=cloud-server
FRONTEND_BASE_URL=https://cloud.vrittiai.com
APP_HOST=cloud.vrittiai.com
CORS_ORIGINS=https://cloud.vrittiai.com,https://admin.vrittiai.com

# ---- Logging ----
LOG_PROVIDER=winston
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_FILE_PATH=/app/logs
LOG_MAX_FILES=14d
MASK_PII=true

# ---- Security ----
COOKIE_SECRET=CHANGE_ME_distinct_random_min_32_chars
HMAC_KEY=CHANGE_ME_distinct_random_min_32_chars
BCRYPT_SALT_ROUNDS=12

# ---- JWT ----
JWT_SECRET=CHANGE_ME_64_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# ---- Cookie / session ----
REFRESH_COOKIE_NAME=vritti_refresh
REFRESH_COOKIE_DOMAIN=vrittiai.com
REFRESH_TOKEN_ROTATION_DAYS=7

# ---- Primary database (NATIVE Postgres on the VM host) ----
PRIMARY_DB_HOST=host.docker.internal
PRIMARY_DB_PORT=5432
PRIMARY_DB_USERNAME=cloud_user
PRIMARY_DB_PASSWORD=CHANGE_ME
PRIMARY_DB_DATABASE=vritti_db
PRIMARY_DB_SCHEMA=cloud
PRIMARY_DB_SSL_MODE=disable

# ---- Redis (shared container; password must match /opt/vritti/.env) ----
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
TABLE_STATE_CACHE_TTL=3600
TABLE_VIEWS_CACHE_TTL=86400

# ---- Email (Brevo) ----
BREVO_API_KEY=CHANGE_ME
SENDER_EMAIL=noreply@vrittiai.com
SENDER_NAME=Vritti

# ---- OTP / MFA ----
OTP_EXPIRY=10m
OTP_MAX_ATTEMPTS=5
MFA_CHALLENGE_TTL_MINUTES=5

# ---- Cloudflare R2 (media storage) ----
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=vritti-cloud-media
R2_PUBLIC_BUCKET=vritti-cloud-public
R2_PUBLIC_URL=https://media.vrittiai.com
MEDIA_MAX_FILE_SIZE_MB=10
MEDIA_MAX_BATCH_SIZE=10
MEDIA_SIGNED_URL_EXPIRY=3600
MEDIA_STORAGE_PROVIDER=r2

# ---- WhatsApp ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_API_VERSION=v21.0

# ---- SMS ----
SMS_BUSINESS_NUMBER=
SMS_VERIFY_TOKEN=
SMS_WEBHOOK_SECRET=

# ---- OAuth (leave blank if unused — must still be present) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://cloud.vrittiai.com/api/auth/google/callback
META_CLIENT_ID=
META_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=https://cloud.vrittiai.com/api/auth/facebook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=https://cloud.vrittiai.com/api/auth/microsoft/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=https://cloud.vrittiai.com/api/auth/x/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=https://cloud.vrittiai.com/api/auth/apple/callback
