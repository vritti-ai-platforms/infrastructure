# Docker Compose Environment Variables
# =====================================
# This file documents the environment variables used by docker-compose.yml
#
# IMPORTANT: No .env file is needed on the server!
# All environment variables are passed at runtime via GitHub Secrets.

# ===========================================
# How to Configure (GitHub Repository Settings)
# ===========================================
#
# Go to: Repository Settings > Environments > production
#
# Configure the following secrets and variables:

# ===========================================
# GitHub SECRETS (Sensitive - Required)
# ===========================================
#
# PRIMARY_DB_HOST        - Database VM private IP address
# PRIMARY_DB_USERNAME    - Database username (e.g., vritti_app)
# PRIMARY_DB_PASSWORD    - Database password
# JWT_SECRET             - JWT signing secret (generate: openssl rand -hex 32)
# COOKIE_SECRET          - Cookie signing secret (generate: openssl rand -hex 16)
# CSRF_HMAC_KEY          - CSRF HMAC key (generate: openssl rand -hex 16)
# ENCRYPTION_KEY         - Encryption key (generate: openssl rand -hex 16)
# BREVO_API_KEY          - Brevo email service API key
# SMS_PROVIDER_API_KEY   - SMS provider API key

# ===========================================
# GitHub VARIABLES (Non-sensitive - Optional)
# ===========================================
# These have defaults but can be overridden:
#
# PRIMARY_DB_PORT        - Default: 5432
# PRIMARY_DB_DATABASE    - Default: saas_db
# PRIMARY_DB_SCHEMA      - Default: cloud
# PRIMARY_DB_SSL_MODE    - Default: require
# WEBAUTHN_RP_ID         - e.g., cloud.vrittiai.com
# WEBAUTHN_ORIGIN        - e.g., https://cloud.vrittiai.com
# REFRESH_COOKIE_DOMAIN  - e.g., cloud.vrittiai.com

# ===========================================
# Default Values (set in docker-compose.yml)
# ===========================================
#
# These values have defaults and don't need to be configured:
#
# NODE_ENV=production
# PORT=3000
# JWT_ACCESS_EXPIRY=15m
# JWT_REFRESH_EXPIRY=30d
# JWT_SIGNUP_EXPIRY=2h
# REFRESH_TOKEN_ROTATION_DAYS=7
# REFRESH_COOKIE_NAME=vritti_refresh
# REFRESH_COOKIE_SECURE=true
# WEBAUTHN_RP_NAME=Vritti
# SENDER_EMAIL=noreply@vrittiai.com
# SENDER_NAME=Vritti
# LOG_PROVIDER=winston
# LOG_TO_FILE=true
# LOG_FILE_PATH=/app/logs
# LOG_MAX_FILES=14d
# MASK_PII=true

# ===========================================
# Deployment Flow
# ===========================================
#
# 1. GitHub Actions reads secrets from repository settings
# 2. Secrets are exported as environment variables on the server VM
# 3. docker compose reads these env vars via ${VAR_NAME} interpolation
# 4. Container receives environment variables at runtime
#
# No .env file exists on the server - all config comes from GitHub Secrets!

# ===========================================
# Verification Commands
# ===========================================
#
# After deployment, verify env vars are set:
#   docker exec vritti-api env | grep -E "DB|JWT"
#
# Check container health:
#   docker exec vritti-api wget -q --spider http://localhost:3000/health && echo "OK"
