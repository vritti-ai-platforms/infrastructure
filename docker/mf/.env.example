# =============================================================================
# Microfrontend env  (template — modeled on commerce-mf, a module-federation remote)
#
# An MF remote is a STATIC bundle built by Rsbuild and served by nginx under the
# host's domain. It has NO deploy/runtime env and NO build-time PUBLIC_* vars:
#   - API calls hit the SAME origin it's served from (/api on the tenant domain).
#   - Shared config (auth, theme, axios client) comes from the HOST app (core-web)
#     at runtime via module-federation shared modules.
#
# ⚠️ Nothing to deploy. There is no /opt/vritti/mf/.env. This folder exists only
#    for symmetry with cloud/ and core/.
#
# The ONLY env reference in the whole app is local-dev HTTPS (rsbuild.config.ts).
# =============================================================================

# Local dev only — serve the Rsbuild dev server over https. Unused in production.
USE_HTTPS=true
